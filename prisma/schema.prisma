generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CITIZEN
  WORKER
  DEPARTMENT_ADMIN
  SUPER_ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  ROUTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ComplaintCategory {
  POTHOLE
  DAMAGED_ROAD
  DAMAGED_FOOTPATH
  ROAD_OBSTRUCTION
  BROKEN_STREETLIGHT
  FLICKERING_STREETLIGHT
  DARK_AREA
  GARBAGE
  OVERFLOWING_DUSTBIN
  ILLEGAL_DUMPING
  WATER_LEAKAGE
  NO_WATER_SUPPLY
  CONTAMINATED_WATER
  BLOCKED_DRAIN
  OVERFLOWING_DRAIN
  DAMAGED_DRAIN
  FALLEN_TREE
  OTHER
}

enum ServiceType {
  ROADS
  STREET_LIGHTING
  SANITATION
  WATER
  DRAINAGE
  PARKS
  OTHER
}

enum RoutingStatus {
  UNASSIGNED
  AI_ANALYZED
  ROUTING_RECOMMENDED
  AUTO_ASSIGNED
  MANUALLY_ASSIGNED
}

enum AiPriority {
  P1
  P2
  P3
  P4
}

enum EvidenceConsistency {
  CONSISTENT
  POTENTIAL_MISMATCH
  NEEDS_REVIEW
  INCONCLUSIVE
}

enum PrioritySource {
  AI
  ADMIN_OVERRIDE
  MANUAL_DEFAULT
}

enum AiClassificationStatus {
  SUCCESS
  FAILURE
  MANUAL_FALLBACK
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole
  name         String
  email        String   @unique
  image        String?
  passwordHash String?
  departmentId String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  complaints         Complaint[]        @relation("CitizenComplaints")
  assignedComplaints Complaint[]        @relation("AssignedComplaints")
  routedComplaints   Complaint[]        @relation("RoutedComplaints")
  historyEntries     ComplaintHistory[]

  @@index([departmentId])
  @@map("users")
}

model Department {
  id                   String              @id @default(uuid()) @db.Uuid
  name                 String              @unique
  code                 String              @unique
  description          String?             @db.VarChar(500)
  latitude             Decimal?            @db.Decimal(9, 6)
  longitude            Decimal?            @db.Decimal(9, 6)
  jurisdictionRadiusKm Decimal?            @db.Decimal(8, 2)
  workloadScore        Int                 @default(0)
  supportedCategories  ComplaintCategory[]
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  users                 User[]
  complaints            Complaint[]
  recommendedComplaints Complaint[]         @relation("RecommendedDepartment")
  categoryRoutes        CategoryRoute[]

  @@map("departments")
}

model CategoryRoute {
  category     ComplaintCategory @id
  departmentId String            @db.Uuid
  updatedAt    DateTime          @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@map("category_routes")
}

model Complaint {
  id               String             @id @default(uuid()) @db.Uuid
  publicRef        String             @unique @db.VarChar(32)
  citizenId        String             @db.Uuid
  departmentId     String?            @db.Uuid
  assignedWorkerId String?            @db.Uuid
  category         ComplaintCategory?
  aiCategory       ComplaintCategory?
  aiDescription    String?
  aiCategoryConfidence Decimal?         @db.Decimal(4, 3)
  evidenceConsistency  EvidenceConsistency?
  evidenceConfidence   Decimal?         @db.Decimal(4, 3)
  evidenceReason       String?
  aiPriority           AiPriority?
  priorityScore        Int?
  civicImpactScore     Int?
  requiresManualReview Boolean          @default(false)
  prioritySource       PrioritySource?
  recommendedDepartmentName String?
  recommendedDepartmentId   String?            @db.Uuid
  recommendedDistanceKm     Decimal?           @db.Decimal(8, 2)
  routingReason             String?            @db.VarChar(500)
  routingConfidence         Decimal?           @db.Decimal(4, 3)
  rankedRecommendations     Json?
  routingStatus             RoutingStatus      @default(UNASSIGNED)
  serviceType               ServiceType?
  aiClassificationReason    String?            @db.VarChar(500)
  routedAt                  DateTime?
  routedById                String?            @db.Uuid
  manualAssignmentReason    String?            @db.VarChar(500)
  recommendedAction         String?
  aiRequestId          String?            @db.VarChar(32)
  historicalTrendScore Int?
  currentContextScore  Int?
  recurringProblem     Boolean          @default(false)
  priorityReason       String?
  description      String
  contactPhone     String?            @db.VarChar(20)
  locationLabel    String?            @db.VarChar(500)
  latitude         Decimal            @db.Decimal(9, 6)
  longitude        Decimal            @db.Decimal(9, 6)
  imageUrl         String
  status           ComplaintStatus    @default(SUBMITTED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  citizen                User               @relation("CitizenComplaints", fields: [citizenId], references: [id], onDelete: Restrict)
  department             Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  recommendedDepartment  Department?        @relation("RecommendedDepartment", fields: [recommendedDepartmentId], references: [id], onDelete: SetNull)
  assignedWorker         User?              @relation("AssignedComplaints", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  routedBy               User?              @relation("RoutedComplaints", fields: [routedById], references: [id], onDelete: SetNull)
  history        ComplaintHistory[]
  aiLogs         AiClassificationLog[]

  @@index([departmentId, status])
  @@index([recommendedDepartmentId])
  @@index([routingStatus])
  @@index([assignedWorkerId])
  @@index([citizenId])
  @@index([createdAt])
  @@index([aiPriority])
  @@index([requiresManualReview])
  @@map("complaints")
}

model AiClassificationLog {
  id                         String                 @id @default(uuid()) @db.Uuid
  complaintId                String                 @db.Uuid
  requestId                  String                 @unique @db.VarChar(32)
  provider                   String                 @default("GEMINI") @db.VarChar(16)
  model                      String                 @db.VarChar(128)
  status                     AiClassificationStatus
  category                   ComplaintCategory?
  categoryConfidence         Decimal?               @db.Decimal(4, 3)
  description                String?
  evidenceConsistency        EvidenceConsistency?
  evidenceConfidence         Decimal?               @db.Decimal(4, 3)
  evidenceReason             String?
  priority                   AiPriority?
  priorityScore              Int?
  civicImpactScore           Int?
  safetyRiskScore            Int?
  publicImpactScore          Int?
  urgencyScore               Int?
  essentialServiceImpactScore Int?
  infrastructureSeverityScore Int?
  healthEnvironmentalRiskScore Int?
  historicalTrendScore       Int?
  currentContextScore        Int?
  recurringProblem           Boolean                @default(false)
  priorityReason             String?
  recommendedDepartment      String?
  recommendedAction          String?
  requiresManualReview       Boolean                @default(false)
  prioritySource             PrioritySource?
  contextSourceTitle         String?
  contextSourceDate          String?
  contextSourceDomain        String?
  contextRelevance           Int?
  contextCheckedAt           DateTime?
  preprocessingMs              Int?
  contextLookupMs            Int?
  inferenceMs                Int?
  databaseMs                 Int?
  totalMs                    Int?
  errorMessage               String?
  createdAt                  DateTime               @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@index([status, createdAt])
  @@index([priority])
  @@map("ai_classification_logs")
}

model ComplaintHistory {
  id          String           @id @default(uuid()) @db.Uuid
  complaintId String           @db.Uuid
  actorId     String?          @db.Uuid
  action      String           @db.VarChar(32)
  oldStatus   ComplaintStatus?
  newStatus   ComplaintStatus
  metadata    String?
  createdAt   DateTime         @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt])
  @@map("complaint_history")
}

