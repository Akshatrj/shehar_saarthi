# Copy to .env.local for development. Never commit real secrets.

# App
# Development: http://localhost:3000
# Production: your Vercel URL, e.g. https://sheharsaarthi.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-openssl-rand-base64-32-chars"

# Google OAuth (server-only; never NEXT_PUBLIC_*)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Database — Neon PostgreSQL (server-only; never NEXT_PUBLIC_*)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Super admin — only this email receives SUPER_ADMIN on Google sign-in
SUPER_ADMIN_EMAIL="admin@example.com"

# Evidence photos — Vercel Blob (server-only; never NEXT_PUBLIC_*)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# AI image classification — Hugging Face Inference Providers (server-only; never NEXT_PUBLIC_*)
HUGGINGFACE_API_KEY="hf_xxxxxxxx"
# Optional vision model on HF router (default: Qwen/Qwen2.5-VL-7B-Instruct)
# HF_VISION_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"
