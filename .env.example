# Copy to .env.local for development. Never commit real secrets.

# App
# Development: http://localhost:3000
# Production: your Vercel URL, e.g. https://sheharsaarthi.vercel.app
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-openssl-rand-base64-32-chars"

# Email/password citizen sign-up is always available at /register.
# Local demo accounts below work only when FOUNDATION_AUTH=true and NODE_ENV is not production.
# Citizen: citizen@sheharsaarthi.local / citizen
FOUNDATION_AUTH="false"

# Google OAuth (server-only; never NEXT_PUBLIC_*)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# Use these exact variable names (not "Client ID" / "Client Secret").
# For a cleaner Google consent screen (logo + app name), configure OAuth consent:
# APIs & Services → OAuth consent screen → App branding (logo, privacy policy URL).
# Testing mode shows a more verbose consent UI until the app is published/verified.
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Database — Neon PostgreSQL (server-only; never NEXT_PUBLIC_*)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Super admin — only this email receives SUPER_ADMIN on Google sign-in
SUPER_ADMIN_EMAIL="admin@example.com"

# Evidence photos — Vercel Blob (server-only; never NEXT_PUBLIC_*)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Google Gemini — civic AI analysis (server-only; never NEXT_PUBLIC_*)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
# GEMINI_TIMEOUT_MS=25000
# AI_CONFIDENCE_THRESHOLD=0.70
# EVIDENCE_REVIEW_THRESHOLD=0.60
# AI_PRIORITY_P1_THRESHOLD=90
# AI_PRIORITY_P2_THRESHOLD=70
# AI_PRIORITY_P3_THRESHOLD=40
# Optional civic context RSS (cached server-side)
# CIVIC_CONTEXT_RSS_URL="https://example.com/civic-news.rss"
