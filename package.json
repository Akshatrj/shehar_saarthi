    "test:phase5": "tsx scripts/test-phase5-category.ts",
    "test:phase6": "tsx scripts/test-phase6-staff.ts",
    "test:phase7": "tsx scripts/test-phase7-dept-admin.ts",
    "test:phase7-citizen": "tsx scripts/test-phase7-citizen.ts",
    "test:phase8": "tsx scripts/test-phase8-admin.ts",
    "test:phase9": "tsx scripts/test-phase9-transitions.ts",
    "test:routing": "tsx scripts/test-routing-engine.ts",
    "test:department-lifecycle": "tsx scripts/test-department-lifecycle.ts",
    "test:complaint-ux": "tsx scripts/test-complaint-ux.ts",
    "test:password-auth": "tsx scripts/test-password-auth.ts",
    "test:role-sync": "tsx scripts/test-role-sync.ts",
    "test:all": "npm run test:phase3 && npm run test:phase4 && npm run test:gemini && npm run test:routing && npm run test:department-lifecycle && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase7-citizen && npm run test:phase8 && npm run test:phase9 && npm run test:complaint-ux && npm run test:password-auth && npm run test:role-sync"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.31.0",
    "next": "^15.5.2",
    "next-auth": "5.0.0-beta.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.3.1"
