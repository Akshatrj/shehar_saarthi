    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.3",
